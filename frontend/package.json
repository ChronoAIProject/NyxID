  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-avatar-emotes.mjs && node scripts/sync-i18n.mjs --overrides-only && tsc -b && vite build && node scripts/prerender-legal.mjs && vite build --config vite.public-render.config.ts && node scripts/prerender-public.mjs && vite build --config vite.credential-accept.config.ts && node scripts/assert-mock-footprint.mjs && node scripts/verify-public-build.mjs && node scripts/collect-crash-artifacts.mjs",
    "build:avatar-emotes": "node scripts/build-avatar-emotes.mjs",
    "check:avatar-emotes": "node scripts/check-avatar-emotes.mjs",
    "build:credential-accept": "vite build --config vite.credential-accept.config.ts",
    "build:wizard": "tsc -b && vite build --config vite.wizard.config.ts && node scripts/install-wizard-bundle.mjs",
    "lint": "eslint . && node scripts/check-typography.mjs && node scripts/check-i18n.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "sync:i18n": "node scripts/sync-i18n.mjs",
    "adopt:i18n": "node scripts/adopt-legacy-i18n.mjs",
    "preview": "vite preview",
    "test": "NODE_ENV=test vitest run",
    "test:producer-contract": "node scripts/verify-aevatar-action-wake.mjs",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:watch": "NODE_ENV=test vitest",
    "build:public-render": "vite build --config vite.public-render.config.ts"
  },
