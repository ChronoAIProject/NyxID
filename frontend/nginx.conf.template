# Proxy claim protection is additional to the SPA's unconditional no-referrer.
map $request_uri $nyxid_has_claim {
    default 0;
    # $request_uri retains the initial path across the SPA's /index.html
    # internal redirect; $uri does not.
    ~^/channel-bots(?:[?]|$) 1;
    ~[?&]claim(?:=|&|$) 1;
    ~^/onboarding/link(?:[?]|$) 1;
}
# Never write raw queries or Referer values. This also protects encoded names,
# duplicate parameters and asset requests from a client ignoring the policy.
map $uri $nyxid_route_label {
    default $uri;
    ~*^/connect/return/[^/]+/?$ $uri;
    ~*^/connect/bot/ /connect/bot/:token;
    ~*^/connect/ /connect/:token;
    ~*^/preview/ /preview/:id;
    ~*^/orgs/join/ /orgs/join/:nonce;
    ~*^/api/v1/orgs/join/ /api/v1/orgs/join/:nonce;
    ~*^/api/v1/users/me/oauth-consent-requests/ /api/v1/users/me/oauth-consent-requests/:handle;
    ~*^/api/v1/proxy/s/[^/]+/ /api/v1/proxy/s/:slug/:path;
    ~*^/api/v1/proxy/nyxbot-voice/[^/]+/ /api/v1/proxy/nyxbot-voice/:service_id/:path;
    ~*^/api/v1/proxy/[^/]+/ /api/v1/proxy/:service_id/:path;
    ~*^/public/s/[^/]+/ /public/s/:slug/:path;
    ~*^/api/v1/llm/[^/]+/v1/ /api/v1/llm/:provider/v1/:path;
    ~*^/api/v1/public-nyxbot/models/[^/]+/ /api/v1/public-nyxbot/models/:service_id/:path;
    ~*^/api/v1/permission-execution/rest/ /api/v1/permission-execution/rest/:path;
    ~*^/credential-accept/ /credential-accept/:path;
    ~*^/nodes/[^/]+/credentials/pending/[^/]+/accept /nodes/:node_id/credentials/pending/:pending_id/accept;
    ~*^/nodes/credentials/pending/[^/]+/fan-out/accept /nodes/credentials/pending/:pending_id/fan-out/accept;
}
log_format nyxid_frontend '$remote_addr - $remote_user [$time_local] '
    '"$request_method $nyxid_access_path $server_protocol" $status $body_bytes_sent '
    '"-" "$http_user_agent" upstream_status=$upstream_status '
    'upstream_response_time=$upstream_response_time upstream_connect_time=$upstream_connect_time';

# Proxy responses keep their own API/OAuth/credential policy. A proxy failure
# receives a restrictive fallback, never the SPA's policy.
map $upstream_http_content_security_policy $nyxid_proxy_csp {
    default $upstream_http_content_security_policy;
    "" "default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'";
}
map "$nyxid_has_claim:$upstream_http_referrer_policy" $nyxid_proxy_referrer {
    default $upstream_http_referrer_policy;
    ~^1: "no-referrer";
    "0:" "strict-origin-when-cross-origin";
}
map $upstream_http_permissions_policy $nyxid_proxy_permissions {
    default $upstream_http_permissions_policy;
    "" "camera=(), microphone=(), geolocation=(), interest-cohort=()";
}

include @@LEGAL_CACHE@@;

# Bound public readiness work across this instance. Local container healthchecks
# bypass both zones, so external overload cannot consume their admission budget.
# Use the connection peer, never client-supplied forwarding headers.
map $remote_addr $nyxid_ready_limit_key {
    127.0.0.1 "";
    ::1 "";
    default $server_name;
}
limit_req_zone $nyxid_ready_limit_key zone=nyxid_frontend_ready_rate:1m rate=10r/s;
limit_conn_zone $nyxid_ready_limit_key zone=nyxid_frontend_ready_active:1m;

server {
    listen @@PORT@@;
    server_name _;

    # Disable absolute redirects to prevent internal port leaks in reverse proxy setups (e.g. :8080)
    absolute_redirect off;

    root @@ROOT@@;
    index index.html;

    # nginx 1.27 stops inheriting add_header as soon as a child adds any.
    # Every location includes its complete, response-specific header policy.
    include @@STATIC_HEADERS@@;
    # Evaluate the cached map on the normalized path before an index redirect.
    set $nyxid_access_path $nyxid_route_label;
    access_log /var/log/nginx/access.log nyxid_frontend;
    # Request diagnostics come from the formatted access log, which records route labels.
    error_log /dev/null;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # Preserve the export's exact byte length and propagate backend aborts.
    location = /api/v1/users/me/export {
        include @@PROXY_HEADERS@@;
        gzip off;
        proxy_buffering off;
        proxy_pass @@BACKEND_URL@@;
        proxy_http_version 1.1;
        proxy_buffer_size 32k;
        proxy_buffers 8 32k;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Proxy API requests to the backend
    location ^~ /api/ {
        include @@PROXY_HEADERS@@;
        proxy_pass @@BACKEND_URL@@;
        proxy_http_version 1.1;
        proxy_buffer_size 32k;
        proxy_buffers 8 32k;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # Reply routes enforce their text/media budgets in the backend. Keep
        # nginx's default 1 MiB cap from rejecting complete 2 MiB text replies.
        location ~ ^/api/v1/channel-relay/(reply|thread-reply)$ {
            client_max_body_size 32m;
            proxy_pass @@BACKEND_URL@@;
        }
    }

    # Standalone credential scripts are verified and served by the backend.
    # ^~ prevents the static .js regex from intercepting this prefix.
    location ^~ /credential-accept/ {
        include @@PROXY_HEADERS@@;
        proxy_pass @@BACKEND_URL@@;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # TEMPORARY: pre-rename backends redirect popup completions to /oauth.
    # Remove after one full release cycle with no old backend callbacks.
    location = /oauth {
        include @@STATIC_HEADERS@@;
        return 302 /oauth-complete$is_args$args;
    }

    # Proxy OAuth requests to the backend
    location ^~ /oauth/ {
        include @@PROXY_HEADERS@@;
        proxy_pass @@BACKEND_URL@@;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy OIDC discovery endpoints to the backend
    location ^~ /.well-known {
        include @@PROXY_HEADERS@@;
        proxy_pass @@BACKEND_URL@@;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy MCP StreamableHTTP endpoint to the backend
    location ^~ /mcp {
        include @@PROXY_HEADERS@@;
        proxy_pass @@BACKEND_URL@@;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # Frontend-only probes never enter the SPA fallback or contact the backend.
    location = /frontend/health {
        include @@STATIC_HEADERS@@;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 200 '{"status":"ok","component":"frontend"}';
    }

    location = /frontend/ready {
        include @@STATIC_HEADERS@@;
        add_header Cache-Control "no-store" always;
        limit_req zone=nyxid_frontend_ready_rate burst=20 nodelay;
        limit_req_status 429;
        limit_conn nyxid_frontend_ready_active 2;
        limit_conn_status 429;
        error_page 429 = @frontend_checker_overloaded;
        proxy_hide_header Cache-Control;
        proxy_pass http://unix:/tmp/nyxid-frontend-readiness.sock:/;
        proxy_connect_timeout 1s;
        proxy_read_timeout 2s;
        proxy_send_timeout 2s;
        proxy_cache off;
        proxy_intercept_errors on;
        error_page 500 502 504 = @frontend_checker_unavailable;
    }

    location @frontend_checker_unavailable {
        include @@STATIC_HEADERS@@;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 503 '{"status":"unavailable","component":"frontend","failing":["checker"]}';
    }

    location @frontend_checker_overloaded {
        include @@STATIC_HEADERS@@;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 503 '{"status":"unavailable","component":"frontend","failing":["overloaded"]}';
    }

    # Reserve probe prefixes: typos/suffixes must not return 200 index.html.
    location ^~ /frontend/health { return 404; }
    location ^~ /frontend/ready { return 404; }

    # /health is also consumed by the SPA release-version checker. Preserve it.
    location ^~ /health {
        include @@PROXY_HEADERS@@;
        proxy_pass @@BACKEND_URL@@;
        proxy_set_header Host $host;
        proxy_cache off;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }

    location = /ready {
        include @@PROXY_HEADERS@@;
        proxy_pass @@BACKEND_URL@@;
        proxy_set_header Host $host;
        proxy_connect_timeout 1s;
        proxy_read_timeout 2s;
        proxy_send_timeout 1s;
        proxy_cache off;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /ready { return 404; }

    location = /build-version.json {
        add_header Cache-Control "no-store" always;
        include @@STATIC_HEADERS@@;
        try_files $uri =404;
    }

    location ~* \.map$ { return 404; }
    # The eye-performance worker is the only script that compiles WebAssembly.
    # This response policy does not widen the SPA or API document policies.
    location ~ ^/assets/rive-motion\.worker-[A-Za-z0-9_-]+\.js$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include @@RIVE_WORKER_HEADERS@@;
        try_files $uri =404;
    }

    # Cache hashed static assets for 1 year
    location ~* \.(?:js|css|wasm|riv|woff2?|svg|png|jpg|jpeg|gif|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include @@STATIC_HEADERS@@;
        try_files $uri =404;
    }

    # Stable content hashes let clients reuse unchanged pages after their
    # 24-hour freshness window, even when unrelated deployments occur.
    location = /privacy {
        default_type text/html;
        etag off;
        if_modified_since off;
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        if ($http_if_none_match = $nyxid_legal_etag) { return 304; }
        add_header ETag $nyxid_legal_etag;
        add_header Cache-Control "public, max-age=86400, must-revalidate";
        include @@STATIC_HEADERS@@;
        try_files /privacy.html =404;
    }

    location = /terms {
        default_type text/html;
        etag off;
        if_modified_since off;
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        if ($http_if_none_match = $nyxid_legal_etag) { return 304; }
        add_header ETag $nyxid_legal_etag;
        add_header Cache-Control "public, max-age=86400, must-revalidate";
        include @@STATIC_HEADERS@@;
        try_files /terms.html =404;
    }

    location = /data-deletion {
        default_type text/html;
        etag off;
        if_modified_since off;
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        if ($http_if_none_match = $nyxid_legal_etag) { return 304; }
        add_header ETag $nyxid_legal_etag;
        add_header Cache-Control "public, max-age=86400, must-revalidate";
        include @@STATIC_HEADERS@@;
        try_files /data-deletion.html =404;
    }

    # SPA fallback -- serve index.html for all non-file routes.
    # Do NOT add `$uri/`: the build mirrors `docs/site/**` into `public/docs/`,
    # so a real `/docs/` directory exists. With `$uri/`, a request to `/docs`
    # matches that directory and nginx 301-redirects to `/docs/`, leaking the
    # internal :8080 listen port into the Location URL and never reaching the
    # SPA router. Real doc assets (`/docs/*.md`, `/docs/search-index.json`) are
    # still served by the `$uri` match; client routes fall through to index.html.
    location / {
        add_header Cache-Control "no-cache" always;
        include @@STATIC_HEADERS@@;
        try_files $uri /index.html;
    }
}
