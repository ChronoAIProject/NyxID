# Merge into the existing build environment; do not overwrite other settings.
# These values are public. Never put credentials or sensitive records here.
# Backend availability never turns a switch on automatically.
VITE_WEBSITE_NEWSLETTER_ENABLED=false
VITE_WEBSITE_NEWSLETTER_ENDPOINT=
VITE_WEBSITE_NEWSLETTER_PRIVACY_URL=
VITE_WEBSITE_NEWSLETTER_UNSUBSCRIBE_URL=
VITE_WEBSITE_NEWSLETTER_ACCEPTANCE=
VITE_WEBSITE_CONTACT_CHAT_ENABLED=false
VITE_WEBSITE_CONTACT_CHAT_ENDPOINT=
VITE_WEBSITE_CONTACT_CHAT_ACCEPTANCE=
VITE_WEBSITE_STATUS_ENABLED=false
VITE_WEBSITE_STATUS_URL=
VITE_WEBSITE_STATUS_ACCEPTANCE=
# Add only individually accepted slugs. Targets use existing authenticated routes.
VITE_WEBSITE_SOLUTION_ACTIVATIONS={}

# Navigation only; direct Blog access, footer link and publication ACL are separate.
VITE_WEBSITE_BLOG_MENU_ENABLED=false
