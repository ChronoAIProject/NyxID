FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY dist/ /usr/share/nginx/html/
COPY dist/public-routing.conf /etc/nginx/public-routing.conf
COPY dist/public-routing-maps.conf /etc/nginx/public-routing-maps.conf
COPY dist/legal-cache.conf /etc/nginx/legal-cache.conf
USER root
RUN apk add --no-cache python3 \
    && mkdir -p /etc/nginx/nyxid/generated \
    && chown 101:101 /etc/nginx/nyxid/generated
COPY nginx.conf.template /etc/nginx/nyxid/default.conf.template
COPY scripts/render-nginx.py /etc/nginx/nyxid/render-nginx.py
COPY --chmod=755 scripts/nginx-policy-entrypoint.sh /docker-entrypoint.d/40-nyxid-policy.sh
COPY nginx-default.conf /etc/nginx/conf.d/default.conf
USER 101
ENV BACKEND_URL=http://host.docker.internal:3001
ENV NYXID_PUBLIC_ORIGIN=http://127.0.0.1:4188
