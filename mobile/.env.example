# ============================================================
# NyxID Mobile — env reference (OSS fork friendly)
# ------------------------------------------------------------
# Copy this file to one or both of:
#   mobile/.env.dev   (used when APP_ENV=dev)
#   mobile/.env.prod  (used when APP_ENV=prod)
# And/or mobile/.env.local for machine-specific overrides.
#
# Fallback rules (applied per-field by mobile/app.config.ts):
#   - Active profile field empty → falls back to the other profile's value.
#   - DEV_API_BASE_URL and PROD_API_BASE_URL both empty → build aborts loudly.
#   - IOS_BUNDLE_ID or ANDROID_PACKAGE missing in both profiles → build aborts.
# ============================================================


# === DEV profile ===
# Filled-in values shown as comments are examples; replace with your own.

DEV_API_BASE_URL=                    # e.g. https://dev.your-api.example.com/api/v1
DEV_IOS_BUNDLE_ID=                   # reverse-DNS, e.g. com.example.myapp.dev
DEV_ANDROID_PACKAGE=                 # reverse-DNS, e.g. com.example.myapp.dev
DEV_APPLE_ASC_APP_ID=                # numeric ASC App ID for the dev iOS app, if separate from prod
DEV_UNIVERSAL_LINK_HOST=             # e.g. dev.yourapp.onelink.me — optional, leave empty to disable
DEV_UNIVERSAL_LINK_PATH_PREFIX=      # e.g. /Abc1 — optional, requires HOST set
DEV_ALLOWED_EMAILS=                  # comma-separated emails; empty = allow all
DEV_TELEMETRY_DSN=                   # PostHog DSN — empty = telemetry off
DEV_TELEMETRY_HOST=                  # PostHog host URL
DEV_SHARE_ANALYTICS=false            # "true" to opt-in to upstream analytics


# === PROD profile ===

PROD_API_BASE_URL=                   # e.g. https://nyx-api.chrono-ai.fun/api/v1
PROD_IOS_BUNDLE_ID=                  # reverse-DNS, e.g. fun.chrono-ai.nyxid
PROD_ANDROID_PACKAGE=                # reverse-DNS, e.g. fun.chronoai.nyxid
PROD_APPLE_ASC_APP_ID=               # numeric ASC App ID for the prod iOS app
PROD_UNIVERSAL_LINK_HOST=            # e.g. nyxid.onelink.me — optional
PROD_UNIVERSAL_LINK_PATH_PREFIX=     # e.g. /REzJ — optional, requires HOST set
PROD_ALLOWED_EMAILS=
PROD_TELEMETRY_DSN=
PROD_TELEMETRY_HOST=
PROD_SHARE_ANALYTICS=false


# ============================================================
# App identity (single values — same for dev and prod builds)
# ============================================================

EAS_PROJECT_ID=                      # UUID; run `eas init` if you don't have one
APP_NAME=NyxID Mobile                # Display name shown on device home screen
APP_SLUG=nyxid-mobile                # EAS project slug (URL-safe)
APP_SCHEME=nyxid                     # Custom URL scheme for deep links (nyxid://...)


# ============================================================
# Submit credentials — only needed for `pnpm submit:*` / `pnpm release:*`
# `pnpm build:*` works without any of these.
# Files referenced here live under mobile/credentials/ (gitignored).
# ============================================================

# Apple / App Store Connect (account-wide; per-app IDs are in the profiles above)
APPLE_ID=                            # Your Apple Developer account email
APPLE_TEAM_ID=                       # 10 chars uppercase+digits; Apple → Membership → Team ID
ASC_API_KEY_ID=                      # 10 chars uppercase+digits; ASC → Users & Access → Integrations
ASC_API_KEY_ISSUER_ID=               # UUID; same screen as Key ID
# Place the .p8 key file at: mobile/credentials/asc-api-key.p8

# Google Play Console (account-wide; per-app config managed in Play Console UI)
# Place the service account JSON at: mobile/credentials/play-service-account.json
# Service account needs at least "Release manager" role + per-app access granted.
