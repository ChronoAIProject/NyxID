# ============================================================
# NyxID Mobile — env reference
# ------------------------------------------------------------
# Copy this file to one or both of:
#   mobile/.env.dev   (used when APP_ENV=dev)
#   mobile/.env.prod  (used when APP_ENV=prod)
#
# Fallback rules (applied by mobile/app.config.ts):
#   - dev profile empty  → falls back to prod values (with warning)
#   - prod profile empty → falls back to dev values (with warning)
#   - both empty         → build fails loudly
# ============================================================


# === DEV profile ===
# Used when APP_ENV=dev. Leave empty to fall back to PROD.
DEV_API_BASE_URL=
DEV_ALLOWED_EMAILS=
DEV_TELEMETRY_DSN=
DEV_TELEMETRY_HOST=
DEV_SHARE_ANALYTICS=false


# === PROD profile ===
# Used when APP_ENV=prod. Leave empty to fall back to DEV.
PROD_API_BASE_URL=https://nyx-api.chrono-ai.fun/api/v1
PROD_ALLOWED_EMAILS=
PROD_TELEMETRY_DSN=
PROD_TELEMETRY_HOST=
PROD_SHARE_ANALYTICS=false


# ============================================================
# Submit credentials (only needed for `pnpm submit:*` / `pnpm release:*`)
# These are interpolated into mobile/eas.json by scripts/render-eas-json.js
# before each EAS invocation.
# ============================================================

# Apple / App Store Connect (values are validated by EAS — formats matter)
APPLE_ID=                # Apple ID email (developer account login)
APPLE_TEAM_ID=           # 10 chars uppercase+digits; Apple → Membership → Team ID
APPLE_ASC_APP_ID=        # Numeric App ID; ASC → app → App Information → "Apple ID"
ASC_API_KEY_ID=          # 10 chars uppercase+digits; ASC → Users & Access → Integrations
ASC_API_KEY_ISSUER_ID=   # UUID; same screen as Key ID
# Place the downloaded .p8 file at: mobile/credentials/asc-api-key.p8

# Google Play Console
# Place the service account JSON at: mobile/credentials/play-service-account.json
# Service account needs at least "Release manager" role + app-level access.
