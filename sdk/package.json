{
  "name": "@nyxids/sdk-workspace",
  "private": true,
  "workspaces": [
    "oauth-core",
    "oauth-react",
    "demo-react"
  ],
  "scripts": {
    "build": "npm run --workspaces build",
    "test": "npm run -w @nyxids/oauth-core test",
    "clean": "npm run --workspaces clean",
    "prepublish:all": "npm run --workspaces prepublishOnly"
  },
  "packageManager": "npm@11.21.1",
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
