#!/usr/bin/env node
// Offline schema validator only. Never run the package installer/download fallback.
const fs = require('node:fs');
const path = require('node:path');
const { spawnSync } = require('node:child_process');
const root = path.resolve(__dirname, '..');
const args = process.argv.slice(2);
if (args.length !== 4 || args[0] !== 'plugin' || args[1] !== 'validate' || args[2] !== '--strict') {
  throw new Error('This locked launcher permits only: claude plugin validate --strict PATH');
}
let platform = process.platform;
if (platform === 'linux') {
  const glibc = process.report.getReport().header.glibcVersionRuntime;
  platform += '-' + process.arch + (glibc ? '' : '-musl');
} else if (platform === 'darwin') {
  platform += '-' + process.arch;
} else {
  throw new Error('Unsupported offline validator platform');
}
const name = '@anthropic-ai/claude-code-' + platform;
const packageRoot = path.join(root, 'node_modules', name);
const installed = JSON.parse(fs.readFileSync(path.join(packageRoot, 'package.json'), 'utf8'));
const lock = JSON.parse(fs.readFileSync(path.join(root, 'package-lock.json'), 'utf8'));
const expected = lock.packages['node_modules/' + name];
if (!expected?.integrity || installed.name !== name || installed.version !== expected.version) {
  throw new Error('Missing or mismatched integrity-locked native validator; run npm ci --ignore-scripts');
}
const binary = path.join(packageRoot, 'claude');
if (!fs.lstatSync(binary).isFile()) throw new Error('Native validator must be a regular file');
const result = spawnSync(binary, args, { stdio: 'inherit', env: {
  ...process.env, CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC: '1', DISABLE_AUTOUPDATER: '1',
}});
if (result.error) throw result.error;
process.exit(result.status ?? 1);
