{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nyxid:cma-usage:v1",
  "title": "CMA usage-only evidence v1",
  "description": "Wire shape only. The decoder additionally enforces byte bounds, duplicate keys, canonical decimal strings, ordering, exact arithmetic, coverage, time and predecessor invariants. No intake or financial effects.",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f](?:[^\\u0000-\\u001f\\u007f-\\u009f]*[^\\s\\u0000-\\u001f\\u007f-\\u009f])?$"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "quantity": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,37})$"
    },
    "counter": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$"
    },
    "millis": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$"
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/text"
        },
        "id": {
          "$ref": "#/$defs/text"
        },
        "revision": {
          "$ref": "#/$defs/counter"
        },
        "part": {
          "$ref": "#/$defs/millis"
        }
      },
      "required": [
        "kind",
        "id",
        "revision",
        "part"
      ],
      "additionalProperties": false
    },
    "owner": {
      "type": "object",
      "properties": {
        "issuer": {
          "$ref": "#/$defs/text"
        },
        "subject": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "issuer",
        "subject",
        "kind"
      ],
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "properties": {
        "start_ms": {
          "$ref": "#/$defs/millis"
        },
        "end_ms": {
          "$ref": "#/$defs/millis"
        }
      },
      "required": [
        "start_ms",
        "end_ms"
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "runtime_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime_generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/counter"
            },
            {
              "type": "null"
            }
          ]
        },
        "home_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "home_generation": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "runtime_id",
        "runtime_generation",
        "home_id",
        "home_generation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "runtime_id": {
                  "type": "null"
                },
                "runtime_generation": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "runtime_id": {
                  "type": "string"
                },
                "runtime_generation": {
                  "type": "string"
                }
              }
            }
          ]
        },
        {
          "oneOf": [
            {
              "properties": {
                "home_id": {
                  "type": "null"
                },
                "home_generation": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "home_id": {
                  "type": "string"
                },
                "home_generation": {
                  "type": "string"
                }
              }
            }
          ]
        }
      ]
    },
    "allocation": {
      "type": "object",
      "properties": {
        "cpu_millis": {
          "$ref": "#/$defs/quantity"
        },
        "memory_mib": {
          "$ref": "#/$defs/quantity"
        },
        "disk_gib": {
          "$ref": "#/$defs/quantity"
        }
      },
      "required": [
        "cpu_millis",
        "memory_mib",
        "disk_gib"
      ],
      "additionalProperties": false
    },
    "audit": {
