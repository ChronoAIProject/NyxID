        "cpu",
        "memory",
        "disk"
      ],
      "additionalProperties": false
    },
    "opening": {
      "type": "object",
      "properties": {
        "first_source": {
          "$ref": "#/$defs/source"
        },
        "capture_start_ms": {
          "$ref": "#/$defs/millis"
        },
        "tracking_started_at_ms": {
          "$ref": "#/$defs/millis"
        },
        "complete_lifecycle": {
          "type": "boolean"
        },
        "historical_missing_ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/range"
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "first_source",
        "capture_start_ms",
        "tracking_started_at_ms",
        "complete_lifecycle",
        "historical_missing_ranges"
      ],
      "additionalProperties": false
    },
    "seal": {
      "type": "object",
      "properties": {
        "final_source": {
          "$ref": "#/$defs/source"
        },
        "sealed_at_ms": {
          "$ref": "#/$defs/millis"
        },
        "reason": {
          "enum": [
            "home_released",
            "owner_changed",
            "incarnation_ended"
          ]
        }
      },
      "required": [
        "final_source",
        "sealed_at_ms",
        "reason"
      ],
      "additionalProperties": false
    },
    "allocated_fact": {
      "type": "object",
      "properties": {
        "fact_id": {
