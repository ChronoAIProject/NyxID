  "drive_upload_file": {
    "parameters": [
      {
        "name": "uploadType",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "media",
            "multipart"
          ]
        },
        "x-nyxid-mcp-enum": [
          "media"
        ],
        "description": "media sends raw content with the request Content-Type identifying the content type. multipart sends multipart/related with a boundary parameter, JSON File metadata as the first part, and content with its own Content-Type as the second part. MCP supports media only."
      },
      {
        "name": "fields",
        "in": "query",
        "required": false,
        "description": "Fields to return, for example id,name,mimeType.",
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "supportsAllDrives",
        "in": "query",
        "required": false,
        "description": "Support shared drives as well as My Drive.",
        "schema": {
          "type": "boolean"
        }
      }
    ],
    "requestBody": {
      "required": true,
      "content": {
        "application/octet-stream": {
          "schema": {
            "type": "string",
            "description": "Raw file bytes. MCP callers supply the binary body using the tool's base64 encoding."
          }
        },
        "multipart/related": {
          "schema": {
            "type": "string",
            "description": "For HTTP/CLI multipart requests set Content-Type: multipart/related; boundary=nyxid_google_doc and send JSON File metadata first, then text/html content. Set metadata mimeType to application/vnd.google-apps.document for the HTML Google Doc import. POST imports a new document; use docs_batch_update_document for targeted edits after creation. The generated MCP tool supports only uploadType=media with a base64 body and application/octet-stream. POST File metadata may optionally include parents to select a folder.",
            "example": "--nyxid_google_doc\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{\"name\":\"Imported document\",\"mimeType\":\"application/vnd.google-apps.document\"}\r\n--nyxid_google_doc\r\nContent-Type: text/html; charset=UTF-8\r\n\r\n<!doctype html><html><body><h1>Imported document</h1><p>Hello from NyxID.</p></body></html>\r\n--nyxid_google_doc--\r\n"
          }
        }
      },
      "x-nyxid-mcp-media": "application/octet-stream"
    },
    "method": "POST",
    "path": "/upload/drive/v3/files"
  },
