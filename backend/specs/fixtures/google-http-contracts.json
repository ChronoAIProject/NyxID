        "application/octet-stream": {
          "schema": {
            "type": "string",
            "description": "Raw file bytes. MCP callers supply the binary body using the tool's base64 encoding."
          }
        },
        "multipart/related": {
          "schema": {
            "type": "string",
            "description": "For HTTP/CLI multipart requests set Content-Type: multipart/related; boundary=nyxid_google_doc and send JSON File metadata first, then text/html content. Set metadata mimeType to application/vnd.google-apps.document for the HTML Google Doc import. This replaces the whole document; use docs_batch_update_document for targeted edits. The generated MCP tool supports only uploadType=media with a base64 body and application/octet-stream. Move files using addParents/removeParents on drive_update_file, not parents in PATCH metadata.",
            "example": "--nyxid_google_doc\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{\"name\":\"Updated document\",\"mimeType\":\"application/vnd.google-apps.document\"}\r\n--nyxid_google_doc\r\nContent-Type: text/html; charset=UTF-8\r\n\r\n<!doctype html><html><body><h1>Updated document</h1><p>Hello from NyxID.</p></body></html>\r\n--nyxid_google_doc--\r\n"
          }
        }
      },
      "x-nyxid-mcp-media": "application/octet-stream"
    },
