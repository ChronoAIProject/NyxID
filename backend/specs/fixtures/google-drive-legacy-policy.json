      "method": "GET",
      "path_template": "/drive/v3/files"
    },
    {
      "method": "POST",
      "path_template": "/drive/v3/files"
    },
    {
      "method": "GET",
      "path_template": "/drive/v3/files/{fileId}"
    },
    {
      "method": "PATCH",
      "path_template": "/drive/v3/files/{fileId}"
    },
    {
