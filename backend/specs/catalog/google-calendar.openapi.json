                  "description": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string"
                  },
                  "start": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "date": {
                        "type": "string",
                        "description": "YYYY-MM-DD for an all-day event."
