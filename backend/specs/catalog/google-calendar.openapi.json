                      "dateTime": {
                        "type": "string",
                        "description": "RFC3339 timestamp."
                      },
                      "timeZone": {
                        "type": "string"
                      }
                    }
                  },
                  "end": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "date": {
                        "type": "string",
                        "description": "Exclusive end date for an all-day event."
                      },
                      "dateTime": {
                        "type": "string",
                        "description": "RFC3339 timestamp."
                      },
                      "timeZone": {
                        "type": "string"
                      }
                    }
                  },
                  "attendees": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "email": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "email"
                      ]
                    }
                  },
                  "recurrence": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "conferenceData": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {}
                  }
