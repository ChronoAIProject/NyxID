{
  "openapi": "3.1.0",
  "info": {
    "title": "Twitter / X API v2",
    "version": "v2-nyxid-overlay",
    "description": "NyxID-hosted overlay of the X API v2 operations most used by agents. Paths are relative to the /2 base; NyxID injects the OAuth token."
  },
  "servers": [
    {
      "url": "https://api.x.com/2",
      "description": "X API v2"
    }
  ],
  "paths": {
    "/users/me": {
      "get": {
        "operationId": "get_me",
        "summary": "Get the authenticated user",
        "x-aevatar-tool": {
          "name": "get_me",
          "description": "Get the authenticated X user profile.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "user.fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated extra user fields.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/tweets/search/recent": {
      "get": {
        "operationId": "search_recent_tweets",
        "summary": "Search recent posts",
        "x-aevatar-tool": {
          "name": "search_recent_tweets",
          "description": "Search X posts from the last 7 days.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Search query using X search operators.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_results",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "next_token",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tweet.fields",
            "in": "query",
            "required": false,
            "description": "Comma-separated extra tweet fields.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/tweets": {
      "post": {
        "operationId": "create_tweet",
        "summary": "Create a post",
        "x-aevatar-tool": {
          "name": "create_tweet",
          "description": "Publish an X post as the authenticated user.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": true
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Post text (required unless media/poll only)."
                  },
                  "reply": {
                    "type": "object",
                    "description": "Reply target settings.",
                    "additionalProperties": true
                  },
                  "quote_tweet_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created post",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/users/by/username/{username}": {
      "get": {
        "operationId": "get_user_by_username",
        "summary": "Get a user by username",
        "x-aevatar-tool": {
          "name": "get_user_by_username",
          "description": "Look up an X user by username.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "user.fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated extra user fields."
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}/tweets": {
      "get": {
        "operationId": "get_user_tweets",
        "summary": "Get a user's posts",
        "x-aevatar-tool": {
          "name": "get_user_tweets",
          "description": "Get recent posts of an X user by user id.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_results",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pagination_token",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tweet.fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated extra tweet fields."
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/tweets/{id}": {
      "delete": {
        "operationId": "delete_tweet",
        "summary": "Delete a post",
        "x-aevatar-tool": {
          "name": "delete_tweet",
          "description": "Delete an X post owned by the authenticated user.",
          "readOnly": false,
          "destructive": true,
          "requiresApproval": true
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/dm_conversations/with/{participant_id}/messages": {
      "post": {
        "operationId": "send_dm",
        "summary": "Send a direct message",
        "x-aevatar-tool": {
          "name": "send_dm",
          "description": "Send an X direct message to a participant. Requires dm.write, tweet.read and users.read; X returns 403 without the required scopes.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": true
        },
        "parameters": [
          {
            "name": "participant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "attachments": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "media_id": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created direct message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/dm_events": {
      "get": {
        "operationId": "list_dm_events",
        "summary": "List direct message events",
        "x-aevatar-tool": {
          "name": "list_dm_events",
          "description": "List X direct message events. Requires dm.read, tweet.read and users.read; X returns 403 without the required scopes.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "max_results",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pagination_token",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "event_types",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated values."
          },
          {
            "name": "dm_event.fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated values."
          }
        ],
        "responses": {
          "200": {
            "description": "Direct message events page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/dm_conversations/with/{participant_id}/dm_events": {
      "get": {
        "operationId": "get_dm_conversation_with_user",
        "summary": "Get direct message events with a user",
        "x-aevatar-tool": {
          "name": "get_dm_conversation_with_user",
          "description": "Read X direct message events with a participant. Requires dm.read, tweet.read and users.read; X returns 403 without the required scopes.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "participant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_results",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pagination_token",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "event_types",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated values."
          },
          {
            "name": "dm_event.fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated values."
          }
        ],
        "responses": {
          "200": {
            "description": "Direct message events page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  }
}
