                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "mimeType": {
                    "type": "string",
                    "description": "Native Google types: application/vnd.google-apps.document (Doc), application/vnd.google-apps.spreadsheet (Sheet), application/vnd.google-apps.presentation (Slides), application/vnd.google-apps.folder (folder)."
                  },
                  "description": {
                    "type": "string"
                  },
