{
  "openapi": "3.1.0",
  "info": {
    "title": "Google API",
    "version": "v1-nyxid-overlay",
    "description": "NyxID-hosted overlay of common Google API operations reachable under www.googleapis.com (userinfo, Gmail, Drive, Calendar), including authoring and rewriting Google Docs, Sheets, and Slides content through Drive. NyxID injects the OAuth token; each product still requires its scope on the stored credential."
  },
  "servers": [
    {
      "url": "https://www.googleapis.com",
      "description": "Google APIs"
    }
  ],
