    "/approval/v4/tasks/forward": {
      "post": {
        "operationId": "approval_task_forward",
        "summary": "Forward a native Lark Approval task to another person",
        "description": "Requires the user OAuth scope approval:task:write. Acts as the authenticated user and changes the task’s approver. Obtain instance_code and task_id from approval_tasks_query and verify support_api_operate. Explicitly select user_id_type matching transfer_user_id. The task must still be actionable by the connected user; do not blindly retry provider state errors. This is the user-token forward endpoint, not the tenant-token tasks/transfer endpoint.",
        "externalDocs": {
          "url": "https://open.larksuite.com/api-explorer?project=approval&resource=task&version=v4&apiName=forward"
        },
        "x-nyxid-changes-existing": true,
        "x-aevatar-tool": {
          "name": "approval_task_forward",
          "description": "Forward an existing native Lark/Feishu Approval task to another person as the connected user. Changes the current approver.",
          "readOnly": false,
          "destructive": true,
          "requiresApproval": true
        },
        "parameters": [
          {
            "name": "user_id_type",
            "in": "query",
            "required": true,
            "description": "ID type of transfer_user_id; select explicitly to avoid recipient ID mismatches.",
            "schema": {
              "type": "string",
              "enum": [
                "open_id",
                "union_id",
                "user_id",
                "user_key"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "instance_code",
                  "task_id",
                  "transfer_user_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "instance_code": {
                    "type": "string",
                    "description": "Approval instance code paired with task_id."
                  },
                  "task_id": {
                    "type": "string",
                    "description": "Approval task ID from the user task list."
                  },
