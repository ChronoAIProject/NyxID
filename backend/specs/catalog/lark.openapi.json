{
  "openapi": "3.1.0",
  "info": {
    "title": "Lark / Feishu API (User OAuth)",
    "version": "v1-nyxid-overlay",
    "description": "NyxID-hosted overlay of the Lark / Feishu open APIs most used by agents acting as a logged-in user: IM messaging, chat discovery, Bitable reads, and native Approval task listing, instance inspection, forwarding, and approval. Paths are relative to the /open-apis base; NyxID injects the user access token."
  },
  "servers": [
    {
      "url": "https://open.larksuite.com/open-apis",
      "description": "Lark (global)"
    },
    {
      "url": "https://open.feishu.cn/open-apis",
      "description": "Feishu (China)"
    }
  ],
  "paths": {
    "/im/v1/messages": {
      "post": {
        "operationId": "im_message_create",
        "summary": "Send a message as the user",
        "description": "Sends a message to a user or chat. `content` is a JSON-encoded string matching `msg_type` (e.g. {\"text\":\"hello\"} for msg_type=text).",
        "x-aevatar-tool": {
          "name": "im_message_create",
          "description": "Send a Lark/Feishu message to a user or chat as the authenticated user.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": true
        },
        "parameters": [
          {
            "name": "receive_id_type",
            "in": "query",
            "required": true,
            "description": "Type of the receive_id value.",
            "schema": {
              "type": "string",
              "enum": [
                "open_id",
                "union_id",
                "user_id",
                "email",
                "chat_id"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "receive_id",
                  "msg_type",
                  "content"
                ],
                "additionalProperties": false,
                "properties": {
                  "receive_id": {
                    "type": "string",
                    "description": "Receiver id matching receive_id_type."
                  },
                  "msg_type": {
                    "type": "string",
                    "description": "Message type, e.g. text, post, interactive, image."
                  },
                  "content": {
                    "type": "string",
                    "description": "JSON-encoded message content string matching msg_type."
                  },
                  "uuid": {
                    "type": "string",
                    "description": "Optional client-generated idempotency key."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "im_messages_list",
        "summary": "List messages in a chat",
        "x-aevatar-tool": {
          "name": "im_messages_list",
          "description": "List Lark/Feishu messages of a chat (container).",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "container_id_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "chat"
              ]
            },
            "description": "Currently only chat."
          },
          {
            "name": "container_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Chat id (oc_...)."
          },
          {
            "name": "start_time",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Unix seconds lower bound."
          },
          {
            "name": "end_time",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Unix seconds upper bound."
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page_token",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
