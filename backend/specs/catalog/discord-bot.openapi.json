{
  "openapi": "3.1.0",
  "info": {
    "title": "Discord Bot API",
    "version": "v10-nyxid-overlay",
    "description": "NyxID-hosted overlay of the Discord Bot API operations most used by agents. Paths are relative to the /api/v10 base; NyxID injects the bot token."
  },
  "servers": [{ "url": "https://discord.com/api/v10", "description": "Discord API" }],
  "paths": {
    "/users/@me": {
      "get": {
        "operationId": "get_current_bot_user",
        "summary": "Get the bot user",
        "x-aevatar-tool": {
          "name": "get_current_bot_user",
          "description": "Get the Discord bot's own user profile.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "responses": {
          "200": {
            "description": "Bot user profile",
            "content": {
              "application/json": {
                "schema": { "type": "object", "additionalProperties": true }
              }
            }
          }
        }
      }
    },
    "/channels/{channel_id}": {
      "get": {
        "operationId": "get_channel",
        "summary": "Get a channel",
        "x-aevatar-tool": {
          "name": "get_channel",
          "description": "Get a Discord channel by id.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "channel_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Channel",
            "content": {
              "application/json": {
                "schema": { "type": "object", "additionalProperties": true }
              }
            }
          }
        }
      }
    },
    "/channels/{channel_id}/messages": {
      "get": {
        "operationId": "list_channel_messages",
        "summary": "List channel messages",
        "x-aevatar-tool": {
          "name": "list_channel_messages",
          "description": "List recent messages of a Discord channel.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "channel_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Message id cursor for pagination.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Message list",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "create_message",
        "summary": "Send a message to a channel",
        "x-aevatar-tool": {
          "name": "create_message",
          "description": "Send a Discord message to a channel as the bot.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": true
        },
        "parameters": [
          {
            "name": "channel_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "content": { "type": "string", "description": "Message text (up to 2000 chars)." },
                  "embeds": {
                    "type": "array",
                    "items": { "type": "object", "additionalProperties": true }
                  },
                  "message_reference": {
                    "type": "object",
                    "description": "Reply target.",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created message",
            "content": {
              "application/json": {
                "schema": { "type": "object", "additionalProperties": true }
              }
            }
          }
        }
      }
    }
  }
}
