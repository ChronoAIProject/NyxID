{
  "openapi": "3.1.0",
  "info": {
    "title": "Discord Bot API",
    "version": "v10-nyxid-overlay",
    "description": "NyxID-hosted overlay of the Discord Bot API operations most used by agents. Paths are relative to the /api/v10 base; NyxID injects the bot token."
  },
  "servers": [
    {
      "url": "https://discord.com/api/v10",
      "description": "Discord API"
    }
  ],
  "paths": {
    "/users/@me": {
      "get": {
        "operationId": "get_current_bot_user",
        "summary": "Get the bot user",
        "x-aevatar-tool": {
          "name": "get_current_bot_user",
          "description": "Get the Discord bot's own user profile.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "responses": {
          "200": {
            "description": "Bot user profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/channels/{channel_id}": {
      "get": {
        "operationId": "get_channel",
        "summary": "Get a channel",
        "x-aevatar-tool": {
          "name": "get_channel",
          "description": "Get a Discord channel by id.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "channel_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Channel",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/channels/{channel_id}/messages": {
      "get": {
        "operationId": "list_channel_messages",
        "summary": "List channel messages",
        "x-aevatar-tool": {
          "name": "list_channel_messages",
          "description": "List recent messages of a Discord channel.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "channel_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Message id cursor for pagination.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Message list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "create_message",
        "summary": "Send a message to a channel",
        "x-aevatar-tool": {
          "name": "create_message",
          "description": "Send a Discord message to a channel as the bot.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": true
        },
        "parameters": [
          {
            "name": "channel_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "content": {
                    "type": "string",
                    "description": "Message text (up to 2000 chars)."
                  },
                  "embeds": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "message_reference": {
                    "type": "object",
                    "description": "Reply target.",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/channels/{channel_id}/messages/{message_id}": {
      "patch": {
        "operationId": "edit_message",
        "summary": "Edit a message",
        "x-aevatar-tool": {
          "name": "edit_message",
          "description": "Edit a Discord message the bot sent.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": true
        },
        "parameters": [
          {
            "name": "channel_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "message_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "embeds": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "delete_message",
        "summary": "Delete a message",
        "x-aevatar-tool": {
          "name": "delete_message",
          "description": "Delete a Discord message.",
          "readOnly": false,
          "destructive": true,
          "requiresApproval": true
        },
        "parameters": [
          {
            "name": "channel_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "message_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/guilds/{guild_id}": {
      "get": {
        "operationId": "get_guild",
        "summary": "Get a guild",
        "x-aevatar-tool": {
          "name": "get_guild",
          "description": "Get a Discord guild (server) by id.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "guild_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/guilds/{guild_id}/channels": {
      "get": {
        "operationId": "list_guild_channels",
        "summary": "List guild channels",
        "x-aevatar-tool": {
          "name": "list_guild_channels",
          "description": "List channels of a Discord guild.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "guild_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Channel list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/guilds/{guild_id}/members/{user_id}": {
      "get": {
        "operationId": "get_guild_member",
        "summary": "Get a guild member",
        "x-aevatar-tool": {
          "name": "get_guild_member",
          "description": "Get a member of a Discord guild.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "guild_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/channels/{channel_id}/messages/{message_id}/reactions/{emoji_name}/@me": {
      "put": {
        "operationId": "add_reaction",
        "summary": "Add a reaction",
        "x-aevatar-tool": {
          "name": "add_reaction",
          "description": "Add an emoji reaction to a Discord message as the bot.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": true
        },
        "parameters": [
          {
            "name": "channel_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "message_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "emoji_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "URL-encoded emoji, e.g. %F0%9F%91%8D or name:id for custom."
          }
        ],
        "responses": {
          "204": {
            "description": "Reaction added"
          }
        }
      }
    }
  }
}
