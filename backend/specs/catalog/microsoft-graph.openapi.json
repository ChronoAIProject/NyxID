{
  "openapi": "3.1.0",
  "info": {
    "title": "Microsoft Graph API",
    "version": "v1.0-nyxid-overlay",
    "description": "NyxID-hosted overlay of the Microsoft Graph operations most used by agents. Paths are relative to the /v1.0 base; NyxID injects the OAuth token."
  },
  "servers": [
    {
      "url": "https://graph.microsoft.com/v1.0",
      "description": "Microsoft Graph"
    }
  ],
  "paths": {
    "/me": {
      "get": {
        "operationId": "get_me",
        "summary": "Get the signed-in user",
        "x-aevatar-tool": {
          "name": "get_me",
          "description": "Get the authenticated Microsoft account profile.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/me/messages": {
      "get": {
        "operationId": "list_my_messages",
        "summary": "List the user's mail messages",
        "x-aevatar-tool": {
          "name": "list_my_messages",
          "description": "List recent Outlook mail messages of the authenticated user.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "$top",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "$filter",
            "in": "query",
            "required": false,
            "description": "OData filter expression.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$search",
            "in": "query",
            "required": false,
            "description": "Search phrase in quotes.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$select",
            "in": "query",
            "required": false,
            "description": "Comma-separated properties to return.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Message page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/me/sendMail": {
      "post": {
        "operationId": "send_mail",
        "summary": "Send a mail message",
        "x-aevatar-tool": {
          "name": "send_mail",
          "description": "Send an Outlook email as the authenticated user.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": true
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "additionalProperties": true,
                "properties": {
                  "message": {
                    "type": "object",
                    "description": "Message with subject, body, and toRecipients.",
                    "additionalProperties": true
                  },
                  "saveToSentItems": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/me/events": {
      "get": {
        "operationId": "list_my_events",
        "summary": "List the user's calendar events",
        "x-aevatar-tool": {
          "name": "list_my_events",
          "description": "List Outlook calendar events of the authenticated user.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "$top",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "$filter",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$orderby",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "create_event",
        "summary": "Create a calendar event",
        "x-aevatar-tool": {
          "name": "create_event",
          "description": "Create an Outlook calendar event.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": true
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "subject",
                  "start",
                  "end"
                ],
                "properties": {
                  "subject": {
                    "type": "string"
                  },
                  "start": {
                    "type": "object",
                    "description": "dateTime + timeZone.",
                    "additionalProperties": true
                  },
                  "end": {
                    "type": "object",
                    "description": "dateTime + timeZone.",
                    "additionalProperties": true
                  },
                  "body": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "attendees": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "location": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created event",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/me/drive/root/children": {
      "get": {
        "operationId": "list_drive_root_children",
        "summary": "List files in the OneDrive root",
        "x-aevatar-tool": {
          "name": "list_drive_root_children",
          "description": "List files and folders in the authenticated user's OneDrive root.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "$top",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Drive item page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/me/messages/{message_id}": {
      "get": {
        "operationId": "get_message",
        "summary": "Get a mail message",
        "x-aevatar-tool": {
          "name": "get_message",
          "description": "Get an Outlook mail message by id.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "message_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "$select",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated properties to return."
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/me/contacts": {
      "get": {
        "operationId": "list_my_contacts",
        "summary": "List contacts",
        "x-aevatar-tool": {
          "name": "list_my_contacts",
          "description": "List Outlook contacts of the authenticated user.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "$top",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "$filter",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "OData filter expression."
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  }
}
