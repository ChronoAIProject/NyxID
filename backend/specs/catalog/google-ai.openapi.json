{
  "openapi": "3.1.0",
  "info": {
    "title": "Google AI (Gemini) API",
    "version": "v1beta-nyxid-overlay",
    "description": "NyxID-hosted overlay of the core Gemini generateContent operations. Paths are relative to the /v1beta base; NyxID injects the API key."
  },
  "servers": [
    {
      "url": "https://generativelanguage.googleapis.com/v1beta",
      "description": "Google AI API"
    }
  ],
  "paths": {
    "/models/{model}:generateContent": {
      "post": {
        "operationId": "generate_content",
        "summary": "Generate content with a Gemini model",
        "x-aevatar-tool": {
          "name": "generate_content",
          "description": "Generate content with a Google Gemini model.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "model",
            "in": "path",
            "required": true,
            "description": "Model id, e.g. gemini-2.0-flash.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "contents"
                ],
                "additionalProperties": true,
                "properties": {
                  "contents": {
                    "type": "array",
                    "description": "Conversation turns with role and parts.",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "generationConfig": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "systemInstruction": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated content",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/models": {
      "get": {
        "operationId": "models_list",
        "summary": "List available models",
        "x-aevatar-tool": {
          "name": "models_list",
          "description": "List Google AI models available to the credential.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "pageToken",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Model list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/models/{model}:countTokens": {
      "post": {
        "operationId": "count_tokens",
        "summary": "Count tokens for a request",
        "x-aevatar-tool": {
          "name": "count_tokens",
          "description": "Count tokens a Gemini request would consume.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "model",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "contents"
                ],
                "properties": {
                  "contents": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/models/{model}:embedContent": {
      "post": {
        "operationId": "embed_content",
        "summary": "Create an embedding",
        "x-aevatar-tool": {
          "name": "embed_content",
          "description": "Create a Gemini embedding for content.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "model",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Embedding model id, e.g. text-embedding-004."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "content"
                ],
                "properties": {
                  "content": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/models/{model}": {
      "get": {
        "operationId": "models_get",
        "summary": "Get a model",
        "x-aevatar-tool": {
          "name": "models_get",
          "description": "Get a Google AI model by id.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "model",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  }
}
