            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "Integer from 1 through 100."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CMA observed response"
          },
          "202": {
            "description": "Accepted; query the exact resource to confirm completion"
          },
          "409": {
            "description": "State, quota, credential setup, or idempotency conflict"
          }
        }
      },
      "post": {
        "operationId": "create_agent",
        "summary": "Create an Agent. Select sandbox_id or workspace_id for an existing environment, never both. Omit machine_included with a parent. No parent creates a new Sandbox only when the account has no environment or unresolved creation.",
        "x-aevatar-tool": {
          "readOnly": false,
          "destructive": true
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Stable key. Retain the exact request bytes and this key for recovery. Use 1-200 ASCII graphic characters, excluding double quotes and backslashes."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CMA observed response"
          },
          "202": {
            "description": "Accepted; query the exact resource to confirm completion"
          },
          "409": {
            "description": "State, quota, credential setup, or idempotency conflict"
          }
        },
        "x-nyxid-changes-existing": false,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "sandbox_id": {
                    "type": "string"
                  },
                  "workspace_id": {
                    "type": "string"
                  },
                  "machine_included": {
                    "type": "boolean"
                  },
                  "image": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "version": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  "repository": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string"
                      },
                      "ref": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "url"
                    ],
                    "additionalProperties": false
                  },
                  "profile": {
                    "type": "object",
                    "properties": {
                      "model": {
                        "type": "string"
                      },
                      "reasoning_effort": {
                        "type": "string"
                      },
                      "permission_mode": {
                        "type": "string"
                      },
                      "system_prompt": {
                        "type": "string"
                      },
                      "skills": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "version": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "permissions": {
                        "type": "object",
                        "properties": {
                          "services": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [],
                        "additionalProperties": false
                      }
                    },
                    "required": [],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
