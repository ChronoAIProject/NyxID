                }
              }
            }
          }
        }
      }
    },
    "/drive/v3/files/{fileId}/export": {
      "get": {
        "operationId": "drive_export_file",
        "summary": "Export a native Google document to the requested MIME type.",
        "x-aevatar-tool": {
          "name": "drive_export_file",
          "description": "Export a native Google document to the requested MIME type.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mimeType",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/upload/drive/v3/files": {
      "post": {
        "operationId": "drive_upload_file",
        "summary": "Upload a new file's raw content. Rename or move it with drive_update_file.",
        "x-aevatar-tool": {
          "name": "drive_upload_file",
          "description": "Upload a new file's raw content. Rename or move it with drive_update_file.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": true
        },
        "parameters": [
          {
            "name": "uploadType",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "media"
              ]
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Fields to return, for example files(id,name,mimeType),nextPageToken.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "supportsAllDrives",
            "in": "query",
            "required": false,
            "description": "Support shared drives as well as My Drive.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "description": "Raw file bytes. MCP callers supply the binary body using the tool's base64 encoding."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
