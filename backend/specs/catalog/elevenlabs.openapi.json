{
  "openapi": "3.1.0",
  "info": {
    "title": "ElevenLabs API",
    "version": "v1-nyxid-overlay",
    "description": "NyxID-hosted overlay for core ElevenLabs text-to-speech and model catalog operations. Realtime WebSocket frame protocols are documented by ElevenLabs and pass through NyxID separately."
  },
  "servers": [
    {
      "url": "https://api.elevenlabs.io",
      "description": "ElevenLabs API"
    }
  ],
  "paths": {
    "/v1/text-to-speech/{voice_id}": {
      "post": {
        "operationId": "text_to_speech",
        "summary": "Generate speech audio",
        "description": "Convert text to speech and return encoded audio.",
        "x-aevatar-tool": {
          "name": "text_to_speech",
          "description": "Generate speech audio from text with an ElevenLabs voice.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "voice_id",
            "in": "path",
            "required": true,
            "description": "ElevenLabs voice identifier.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "output_format",
            "in": "query",
            "required": false,
            "description": "Audio output format such as mp3_44100_128 or pcm_16000.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "additionalProperties": true,
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Text to convert to speech."
                  },
                  "model_id": {
                    "type": "string",
                    "description": "Text-to-speech model identifier.",
                    "default": "eleven_multilingual_v2"
                  },
                  "language_code": {
                    "type": "string",
                    "description": "Optional ISO 639-1 language code."
                  },
                  "voice_settings": {
                    "type": "object",
                    "description": "Optional per-request voice settings.",
                    "additionalProperties": true
                  },
                  "seed": {
                    "type": "integer",
                    "description": "Optional deterministic sampling seed."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated audio",
            "content": {
              "audio/mpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/v1/text-to-speech/{voice_id}/stream": {
      "post": {
        "operationId": "text_to_speech_stream",
        "summary": "Stream generated speech audio",
        "description": "Convert text to speech and stream binary audio chunks as they are generated.",
        "x-aevatar-tool": {
          "name": "text_to_speech_stream",
          "description": "Stream ElevenLabs speech audio generated from text.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "voice_id",
            "in": "path",
            "required": true,
            "description": "ElevenLabs voice identifier.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "output_format",
            "in": "query",
            "required": false,
            "description": "Audio output format such as mp3_44100_128 or pcm_16000.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "optimize_streaming_latency",
            "in": "query",
            "required": false,
            "description": "Optional latency optimization level supported by ElevenLabs.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "additionalProperties": true,
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Text to convert to speech."
                  },
                  "model_id": {
                    "type": "string",
                    "description": "Text-to-speech model identifier.",
                    "default": "eleven_multilingual_v2"
                  },
                  "language_code": {
                    "type": "string",
                    "description": "Optional ISO 639-1 language code."
                  },
                  "voice_settings": {
                    "type": "object",
                    "description": "Optional per-request voice settings.",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Streaming generated audio",
            "content": {
              "audio/mpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "list_models",
        "summary": "List models",
        "x-aevatar-tool": {
          "name": "list_models",
          "description": "List ElevenLabs models and their supported capabilities.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "responses": {
          "200": {
            "description": "Model list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "elevenLabsApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "xi-api-key"
      }
    }
  },
  "security": [
    {
      "elevenLabsApiKey": []
    }
  ]
}
