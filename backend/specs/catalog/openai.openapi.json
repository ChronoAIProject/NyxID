{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAI API",
    "version": "v1-nyxid-overlay",
    "description": "NyxID-hosted overlay of the core OpenAI API operations. Paths are relative to the /v1 base; NyxID injects the API key."
  },
  "servers": [
    {
      "url": "https://api.openai.com/v1",
      "description": "OpenAI API"
    }
  ],
  "paths": {
    "/chat/completions": {
      "post": {
        "operationId": "chat_completions",
        "summary": "Create a chat completion",
        "x-aevatar-tool": {
          "name": "chat_completions",
          "description": "Create an OpenAI chat completion.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "messages"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Model id, e.g. gpt-4o."
                  },
                  "messages": {
                    "type": "array",
                    "description": "Conversation messages with role and content.",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "temperature": {
                    "type": "number"
                  },
                  "max_tokens": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat completion",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/responses": {
      "post": {
        "operationId": "responses_create",
        "summary": "Create a model response (Responses API)",
        "x-aevatar-tool": {
          "name": "responses_create",
          "description": "Create an OpenAI Responses API response.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "input": {
                    "description": "String prompt or structured input items.",
                    "type": [
                      "string",
                      "array"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Model response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/embeddings": {
      "post": {
        "operationId": "embeddings_create",
        "summary": "Create embeddings",
        "x-aevatar-tool": {
          "name": "embeddings_create",
          "description": "Create OpenAI embeddings for input text.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "input"
                ],
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "e.g. text-embedding-3-small."
                  },
                  "input": {
                    "type": [
                      "string",
                      "array"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Embedding vectors",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/models": {
      "get": {
        "operationId": "models_list",
        "summary": "List available models",
        "x-aevatar-tool": {
          "name": "models_list",
          "description": "List OpenAI models available to the credential.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "responses": {
          "200": {
            "description": "Model list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/images/generations": {
      "post": {
        "operationId": "images_generate",
        "summary": "Generate images",
        "x-aevatar-tool": {
          "name": "images_generate",
          "description": "Generate images with OpenAI.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "e.g. gpt-image-1."
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  },
                  "size": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/moderations": {
      "post": {
        "operationId": "moderations_create",
        "summary": "Classify content for policy violations",
        "x-aevatar-tool": {
          "name": "moderations_create",
          "description": "Run OpenAI content moderation over input text.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "input"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "input": {
                    "type": [
                      "string",
                      "array"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/models/{model}": {
      "get": {
        "operationId": "models_get",
        "summary": "Get a model",
        "x-aevatar-tool": {
          "name": "models_get",
          "description": "Get an OpenAI model by id.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "model",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  }
}
