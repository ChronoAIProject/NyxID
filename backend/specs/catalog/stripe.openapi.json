    "title": "Stripe",
    "version": "1.0.0-nyxid-overlay",
    "description": "Read-only Stripe API v1 operations. NyxID injects the connected Stripe Apps OAuth token. Permissions are configured in the Stripe app manifest."
  },
  "servers": [
    {
      "url": "https://api.stripe.com"
    }
  ],
  "paths": {
    "/v1/customers": {
      "get": {
        "operationId": "stripe_list_customers",
        "summary": "List customers.",
        "x-aevatar-tool": {
          "name": "stripe_list_customers",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "description": "Page size from 1 to 100; Stripe enforces this range."
            }
          },
          {
            "name": "starting_after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Object ID from the previous page."
            }
          },
          {
            "name": "email",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "created[gte]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "Unix timestamp in seconds."
            }
          },
          {
            "name": "created[lte]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "Unix timestamp in seconds."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stripe resource data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
