{
  "openapi": "3.1.0",
  "info": {
    "title": "Telegram Bot API",
    "version": "v1-nyxid-overlay",
    "description": "NyxID-hosted overlay of the Telegram Bot API methods most used by agents. Pass only the method name as the path; NyxID prepends bot<token>/ automatically."
  },
  "servers": [
    {
      "url": "https://api.telegram.org",
      "description": "Telegram Bot API"
    }
  ],
  "paths": {
    "/getMe": {
      "get": {
        "operationId": "get_me",
        "summary": "Get the bot identity",
        "x-aevatar-tool": {
          "name": "get_me",
          "description": "Get the Telegram bot's own identity.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "responses": {
          "200": {
            "description": "Bot identity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/sendMessage": {
      "post": {
        "operationId": "send_message",
        "summary": "Send a text message",
        "x-aevatar-tool": {
          "name": "send_message",
          "description": "Send a Telegram message to a chat as the bot.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": true
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "chat_id",
                  "text"
                ],
                "additionalProperties": true,
                "properties": {
                  "chat_id": {
                    "description": "Target chat id or @channelusername."
                  },
                  "text": {
                    "type": "string"
                  },
                  "parse_mode": {
                    "type": "string",
                    "enum": [
                      "MarkdownV2",
                      "HTML",
                      "Markdown"
                    ]
                  },
                  "reply_to_message_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sent message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/getChat": {
      "get": {
        "operationId": "get_chat",
        "summary": "Get chat info",
        "x-aevatar-tool": {
          "name": "get_chat",
          "description": "Get information about a Telegram chat.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "chat_id",
            "in": "query",
            "required": true,
            "description": "Chat id or @channelusername.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chat info",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/getUpdates": {
      "get": {
        "operationId": "get_updates",
        "summary": "Poll bot updates",
        "description": "Long-poll incoming updates. Only usable when no webhook is configured for the bot.",
        "x-aevatar-tool": {
          "name": "get_updates",
          "description": "Poll incoming Telegram updates for the bot (webhook must be unset).",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "timeout",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Update list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/sendPhoto": {
      "post": {
        "operationId": "send_photo",
        "summary": "Send a photo",
        "x-aevatar-tool": {
          "name": "send_photo",
          "description": "Send a photo to a Telegram chat (URL or file_id).",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": true
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "chat_id",
                  "photo"
                ],
                "properties": {
                  "chat_id": {},
                  "photo": {
                    "type": "string",
                    "description": "HTTP URL or Telegram file_id."
                  },
                  "caption": {
                    "type": "string"
                  },
                  "parse_mode": {
                    "type": "string",
                    "enum": [
                      "MarkdownV2",
                      "HTML",
                      "Markdown"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/sendDocument": {
      "post": {
        "operationId": "send_document",
        "summary": "Send a document",
        "x-aevatar-tool": {
          "name": "send_document",
          "description": "Send a document to a Telegram chat (URL or file_id).",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": true
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "chat_id",
                  "document"
                ],
                "properties": {
                  "chat_id": {},
                  "document": {
                    "type": "string",
                    "description": "HTTP URL or Telegram file_id."
                  },
                  "caption": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/editMessageText": {
      "post": {
        "operationId": "edit_message_text",
        "summary": "Edit a message's text",
        "x-aevatar-tool": {
          "name": "edit_message_text",
          "description": "Edit the text of a Telegram message the bot sent.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": true
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "chat_id",
                  "message_id",
                  "text"
                ],
                "properties": {
                  "chat_id": {},
                  "message_id": {
                    "type": "integer"
                  },
                  "text": {
                    "type": "string"
                  },
                  "parse_mode": {
                    "type": "string",
                    "enum": [
                      "MarkdownV2",
                      "HTML",
                      "Markdown"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/deleteMessage": {
      "post": {
        "operationId": "delete_message",
        "summary": "Delete a message",
        "x-aevatar-tool": {
          "name": "delete_message",
          "description": "Delete a Telegram message.",
          "readOnly": false,
          "destructive": true,
          "requiresApproval": true
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "chat_id",
                  "message_id"
                ],
                "properties": {
                  "chat_id": {},
                  "message_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/forwardMessage": {
      "post": {
        "operationId": "forward_message",
        "summary": "Forward a message",
        "x-aevatar-tool": {
          "name": "forward_message",
          "description": "Forward a Telegram message to another chat.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": true
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "chat_id",
                  "from_chat_id",
                  "message_id"
                ],
                "properties": {
                  "chat_id": {},
                  "from_chat_id": {},
                  "message_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/getWebhookInfo": {
      "get": {
        "operationId": "get_webhook_info",
        "summary": "Get webhook status",
        "x-aevatar-tool": {
          "name": "get_webhook_info",
          "description": "Get the Telegram bot's current webhook status.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/answerCallbackQuery": {
      "post": {
        "operationId": "answer_callback_query",
        "summary": "Answer a callback query",
        "x-aevatar-tool": {
          "name": "answer_callback_query",
          "description": "Answer a Telegram inline-keyboard callback query.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "callback_query_id"
                ],
                "properties": {
                  "callback_query_id": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "show_alert": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  }
}
