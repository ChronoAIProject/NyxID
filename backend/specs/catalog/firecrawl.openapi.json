{
  "openapi": "3.1.0",
  "info": {
    "title": "Firecrawl API",
    "version": "v2-nyxid-overlay",
    "description": "NyxID-hosted Firecrawl OpenAPI overlay with Aevatar tool annotations for scrape and search operations."
  },
  "servers": [
    {
      "url": "https://api.firecrawl.dev",
      "description": "Firecrawl API"
    }
  ],
  "paths": {
    "/v2/scrape": {
      "post": {
        "operationId": "scrape",
        "summary": "Scrape a single URL",
        "x-aevatar-tool": {
          "name": "scrape",
          "description": "Scrape one URL with Firecrawl and return its content.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "formats": {
                    "type": "array",
                    "description": "e.g. markdown, html, links.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "onlyMainContent": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/v2/search": {
      "post": {
        "operationId": "search",
        "summary": "Search the web",
        "x-aevatar-tool": {
          "name": "search",
          "description": "Run a Firecrawl web search, optionally scraping results.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "integer"
                  },
                  "scrapeOptions": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "firecrawlApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Firecrawl API key"
      }
    }
  },
  "security": [
    {
      "firecrawlApiKey": []
    }
  ]
}
