{
  "openapi": "3.1.0",
  "info": {
    "title": "Firecrawl API",
    "version": "v2-nyxid-overlay",
    "description": "NyxID-hosted Firecrawl OpenAPI overlay with Aevatar tool annotations for asynchronous agent submit and poll operations."
  },
  "servers": [
    {
      "url": "https://api.firecrawl.dev",
      "description": "Firecrawl API"
    }
  ],
  "paths": {
    "/v2/agent": {
      "post": {
        "operationId": "agent",
        "summary": "Submit a Firecrawl agent task",
        "description": "Starts an asynchronous Firecrawl agent task. Poll the returned id with GET /v2/agent/{id}.",
        "x-aevatar-tool": {
          "name": "agent",
          "description": "Submit an asynchronous Firecrawl agent task.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "prompt"
                ],
                "additionalProperties": false,
                "properties": {
                  "prompt": {
                    "type": "string",
                    "description": "Natural-language task for the Firecrawl agent."
                  },
                  "urls": {
                    "type": "array",
                    "description": "Optional starting URLs for the agent.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "schema": {
                    "type": "object",
                    "description": "Optional structured extraction schema.",
                    "additionalProperties": true
                  },
                  "model": {
                    "type": "string",
                    "description": "Optional model override."
                  },
                  "maxCredits": {
                    "type": "integer",
                    "description": "Optional maximum credits to spend on the task."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent task accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "id": {
                      "type": "string",
                      "description": "Agent task id to poll."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/agent/{id}": {
      "get": {
        "operationId": "agent_status",
        "summary": "Poll a Firecrawl agent task",
        "description": "Returns the current status and result for an asynchronous Firecrawl agent task.",
        "x-aevatar-tool": {
          "name": "agent_status",
          "description": "Poll an asynchronous Firecrawl agent task.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Firecrawl agent task id returned by POST /v2/agent.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agent task status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "status": {
                      "type": "string",
                      "description": "Current task status."
                    },
                    "data": {
                      "description": "Completed task result, when available."
                    },
                    "error": {
                      "type": "string",
                      "description": "Failure details, when available."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/scrape": {
      "post": {
        "operationId": "scrape",
        "summary": "Scrape a single URL",
        "x-aevatar-tool": {
          "name": "scrape",
          "description": "Extract readable content from one public URL. Request markdown for page body. A title-only result is incomplete; bounded waitFor may help JavaScript pages. maxAge controls cache eligibility, not proof that this response was live. Do not send private cookies or headers.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "Public http(s) URL only; never pass private authenticated URLs."
                  },
                  "formats": {
                    "type": "array",
                    "description": "Readable body is returned in data.markdown when markdown is requested.",
                    "items": { "type": "string" }
                  },
                  "onlyMainContent": {
                    "type": "boolean"
                  },
                  "waitFor": {
                    "type": "integer",
                    "description": "Additional JavaScript render wait in milliseconds; use 0 to 10000 and at most one extra attempt for thin output."
                  },
                  "timeout": {
                    "type": "integer",
                    "description": "Request timeout in milliseconds; use 1000 to 60000."
                  },
                  "maxAge": {
                    "type": "integer",
                    "description": "Cached page maximum age in milliseconds; 0 requests a fresh scrape. Use at most 172800000. The response does not certify cache hit or render method."
                  },
                  "storeInCache": {
                    "type": "boolean",
                    "description": "Whether Firecrawl may store the page in its index and cache."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scrape result. Report sourceURL, final url, statusCode and provider when present; do not infer cache hit or render method from absent metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "markdown": { "type": "string" },
                        "html": { "type": "string" },
                        "links": { "type": "array", "items": { "type": "string" } },
                        "metadata": {
                          "type": "object",
                          "additionalProperties": true,
                          "properties": {
                            "title": { "type": "string" },
                            "sourceURL": { "type": "string" },
                            "url": { "type": "string" },
                            "statusCode": { "type": "integer" },
                            "contentType": { "type": "string" },
                            "provider": {
                              "type": "object",
                              "additionalProperties": true,
                              "properties": {
                                "id": { "type": "string" },
                                "creditsCost": { "type": "integer" },
                                "steps": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "properties": {
                                      "provider": { "type": "string" },
                                      "status": { "type": "string" },
                                      "creditsCost": { "type": "integer" }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/search": {
      "post": {
        "operationId": "search",
        "summary": "Search the web",
        "x-aevatar-tool": {
          "name": "search",
          "description": "Run a Firecrawl web search, optionally scraping results.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "integer"
                  },
                  "scrapeOptions": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/v2/map": {
      "post": {
        "operationId": "map_site",
        "summary": "Map a site's URLs",
        "x-aevatar-tool": {
          "name": "map_site",
          "description": "Discover public page URLs. sitemap=include combines sitemap and other discovery, only uses sitemap URLs, skip ignores it. Sitemap data can be cached up to seven days; ignoreCache requests fresh discovery.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "Public http(s) site URL."
                  },
                  "search": {
                    "type": "string",
                    "description": "Optional filter query."
                  },
                  "limit": {
                    "type": "integer",
                    "description": "Maximum URLs to return; use 1 to 200 for focused research."
                  },
                  "sitemap": {
                    "type": "string",
                    "enum": ["include", "only", "skip"],
                    "description": "Use sitemap together with other methods, exclusively, or not at all."
                  },
                  "includeSubdomains": { "type": "boolean" },
                  "ignoreQueryParameters": { "type": "boolean" },
                  "ignoreCache": {
                    "type": "boolean",
                    "description": "Bypass Firecrawl's sitemap cache, which can be up to seven days old."
                  },
                  "timeout": {
                    "type": "integer",
                    "description": "Timeout in milliseconds; use 1000 to 60000 because Firecrawl has no map timeout by default."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "success": { "type": "boolean" },
                    "links": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["url"],
                        "properties": {
                          "url": { "type": "string" },
                          "title": { "type": "string" },
                          "description": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "firecrawlApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Firecrawl API key"
      }
    }
  },
  "security": [
    {
      "firecrawlApiKey": []
    }
  ]
}
