{
  "openapi": "3.1.0",
  "info": {
    "title": "Telnyx API",
    "version": "v2-nyxid-overlay",
    "description": "NyxID-hosted overlay for Telnyx AI inference, assistants, speech, messaging, and calling. Paths are relative to /v2. Incoming webhooks and call media streams require a separate application receiver."
  },
  "servers": [
    {
      "url": "https://api.telnyx.com/v2"
    }
  ],
  "paths": {
    "/ai/openai/models": {
      "get": {
        "operationId": "list_models",
        "summary": "List available Telnyx AI models.",
        "x-aevatar-tool": {
          "name": "list_models",
          "description": "List available Telnyx AI models.",
          "readOnly": true,
          "destructive": false,
          "requiresApproval": false
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/ai/openai/chat/completions": {
      "post": {
        "operationId": "chat_completions",
        "summary": "Generate a Telnyx OpenAI-compatible chat completion.",
        "x-aevatar-tool": {
          "name": "chat_completions",
          "description": "Generate a Telnyx OpenAI-compatible chat completion.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Model ID returned by list_models."
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "role": {
                          "type": "string"
                        },
                        "content": {
                          "description": "Text or an array of OpenAI-compatible content parts."
                        }
                      },
                      "required": [
                        "role"
                      ]
                    }
                  },
                  "stream": {
                    "type": "boolean"
                  },
                  "temperature": {
                    "type": "number"
                  },
                  "max_tokens": {
                    "type": "integer"
                  },
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "tool_choice": {
                    "type": "string",
                    "enum": [
                      "none",
                      "auto",
                      "required"
                    ]
                  },
                  "response_format": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "messages"
                ]
              }
            }
          }
        }
      }
    },
    "/ai/openai/embeddings": {
      "post": {
        "operationId": "create_embeddings",
        "summary": "Create embedding vectors with a Telnyx model.",
        "x-aevatar-tool": {
          "name": "create_embeddings",
          "description": "Create embedding vectors with a Telnyx model.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "input": {
                    "description": "A string, array of strings, token array, or array of token arrays."
                  },
                  "encoding_format": {
                    "type": "string",
                    "enum": [
                      "float",
                      "base64"
                    ]
                  },
                  "dimensions": {
                    "type": "integer"
                  }
                },
                "required": [
                  "model",
                  "input"
                ]
              }
            }
          }
        }
      }
    },
    "/ai/openai/responses": {
      "post": {
        "operationId": "create_response",
        "summary": "Generate a Telnyx OpenAI-compatible response.",
        "x-aevatar-tool": {
          "name": "create_response",
          "description": "Generate a Telnyx OpenAI-compatible response.",
          "readOnly": false,
          "destructive": false,
          "requiresApproval": false
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "input": {
                    "description": "Text or OpenAI-compatible input items."
                  },
                  "instructions": {
                    "type": "string"
                  },
                  "conversation": {
                    "type": "string",
                    "description": "Optional Telnyx conversation ID from create_conversation; omit for a stateless response."
                  },
                  "stream": {
                    "type": "boolean"
                  },
                  "reasoning": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ai/assistants": {
      "get": {
        "operationId": "list_assistants",
        "summary": "List AI assistants on the connected Telnyx account.",
        "x-aevatar-tool": {
          "name": "list_assistants",
          "description": "List AI assistants on the connected Telnyx account.",
