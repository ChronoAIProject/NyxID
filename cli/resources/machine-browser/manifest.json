{
  "manifest_version": 3,
  "name": "NyxID saved login filler",
  "version": "1.0.0",
  "description": "Fill owner-approved website logins through the local NyxID node.",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "webNavigation",
    "management"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "policy.js",
        "content.js",
        "browser-actions.js",
        "browser-content.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
