# Test-only tooling for a trusted local HTTPS site and a protocol test server.
ARG MACHINE_IMAGE=nyxid-node-machine:local
FROM ${MACHINE_IMAGE}
RUN if ! timeout --kill-after=5s 60s apt-get -o Acquire::Retries=0 -o APT::Update::Error-Mode=any update; then \
      sed -i 's|http://archive.ubuntu.com/ubuntu|https://mirrors.edge.kernel.org/ubuntu|g; s|http://security.ubuntu.com/ubuntu|https://mirrors.edge.kernel.org/ubuntu|g; s|https://archive.ubuntu.com/ubuntu|https://mirrors.edge.kernel.org/ubuntu|g; s|https://security.ubuntu.com/ubuntu|https://mirrors.edge.kernel.org/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources \
      && timeout --kill-after=5s 90s apt-get -o Acquire::Retries=0 -o APT::Update::Error-Mode=any update; \
    fi \
    && apt-get install -y --no-install-recommends libnss3-tools node-ws \
    && rm -rf /var/lib/apt/lists/*
COPY cli/tests/machine_container_e2e.mjs cli/tests/machine_context_e2e.mjs /test/
COPY cli/tests/machine_native_probe_drop.py /test/
COPY cli/tests/machine_native_host_e2e.py /test/
COPY cli/tests/machine_filler.test.mjs /test/machine_filler.test.mjs
COPY cli/resources/machine-browser/ /resources/machine-browser/
RUN node --test /test/machine_filler.test.mjs
ENTRYPOINT ["node", "/test/machine_container_e2e.mjs"]
