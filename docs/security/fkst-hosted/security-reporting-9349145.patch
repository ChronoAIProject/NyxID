+        let mut current = self.depth.load(Ordering::Relaxed);
+        let depth = loop {
+            let next = current.saturating_sub(1);
+            match self.depth.compare_exchange_weak(
+                current,
+                next,
+                Ordering::Relaxed,
+                Ordering::Relaxed,
+            ) {
+                Ok(_) => break next,
+                Err(observed) => current = observed,
+            }
+        };
         self.metrics.set_queue_depth(depth);
     }

