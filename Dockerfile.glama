# Reference Dockerfile for the Glama directory listing.
#
# This file is documentation, not a build artifact: Glama's UI does not
# auto-read it from the repo. Supply this full Dockerfile and its repository
# context at an immutable source revision in Glama's admin build configuration.
#
# Builds the standalone `nyxid-mcp-demo` crate (just serde_json + std)
# instead of the full `nyxid` backend so the cargo build --locked finishes in
# under a minute on a constrained CI runner. The full backend speaks
# the same MCP surface over Streamable HTTP at /mcp on a real NyxID
# deployment — see the `mcp-demo` crate's main.rs for the parity notes.

FROM rust:1.98.1-bookworm@sha256:93ce27a88655056a51dbdd8f5f2d7ddc071c7b0070fb288a37b5a285fc83971e AS builder
WORKDIR /src
# Build the reviewed checkout; the external Glama UI must select an immutable
# source revision and supply this same repository context.
COPY . .
RUN python3 scripts/bootstrap-build-tool.py cargo-auditable --bin-dir /usr/local/cargo/bin
RUN cargo auditable build --locked --release -p nyxid-mcp-demo \
 && strip target/release/nyxid-mcp-demo

FROM debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
COPY --from=builder /src/target/release/nyxid-mcp-demo /usr/local/bin/nyxid-mcp-demo

CMD ["nyxid-mcp-demo"]
